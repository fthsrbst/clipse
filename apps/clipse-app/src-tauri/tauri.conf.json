{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipse",
  "version": "0.1.0",
  "identifier": "dev.clipse.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Clipse",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 420,
        "visible": true,
        "decorations": false
      },
      {
        "label": "popup",
        "title": "Clipse",
        "url": "index.html",
        "width": 420,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Fatih Serbest",
    "category": "Utility",
    "shortDescription": "Clipboard sync for your own devices",
    "longDescription": "Clipse syncs your clipboard between your own computers over your local network or your Tailscale tailnet. No server, no account, no cloud. Password-manager copies are never stored or sent.",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libxcb1",
          "libxcb-xfixes0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/fatihxserbest/clipse/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
